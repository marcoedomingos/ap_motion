<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1080 1920" width="1080" height="1920">
  <defs>
    <linearGradient id="crimsonBg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="22%" stop-color="#ffffff"/>
      <stop offset="23%" stop-color="#8c0012"/>
      <stop offset="45%" stop-color="#a60d1f"/>
      <stop offset="75%" stop-color="#730510"/>
      <stop offset="100%" stop-color="#4a0208"/>
    </linearGradient>
    <linearGradient id="coneGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#e71d36"/>
      <stop offset="35%" stop-color="#ff334b"/>
      <stop offset="70%" stop-color="#c91026"/>
      <stop offset="100%" stop-color="#800a18"/>
    </linearGradient>
    <filter id="megaShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="16" stdDeviation="20" flood-color="#000000" flood-opacity="0.45"/>
    </filter>
  </defs>

  <!-- Background Split: Clean White Top, Crimson Banner from Y=440 -->
  <rect width="1080" height="1920" fill="url(#crimsonBg)"/>

  <!-- Top Right: Church & Choir Logo -->
  <g transform="translate(860, 160)">
    <!-- Circular Seal -->
    <circle cx="0" cy="0" r="130" fill="#ffffff" stroke="#1e293b" stroke-width="3" filter="url(#megaShadow)"/>
    <circle cx="0" cy="0" r="118" fill="none" stroke="#64748b" stroke-width="1.5" stroke-dasharray="3 3"/>
    
    <!-- Curved text: Igreja Metodista Unida BRED -->
    <!-- Methodism Cross & Flame Emblem -->
    <!-- Black Cross -->
    <rect x="-8" y="-70" width="16" height="120" fill="#1e293b"/>
    <rect x="-40" y="-45" width="80" height="16" fill="#1e293b"/>
    <!-- Red Dual Flame wrapping cross -->
    <path d="M -30 40 C -50 10 -40 -30 -15 -60 C -10 -40 -5 -20 -5 0 C -5 20 -15 35 -30 40 Z" fill="#e71d36"/>
    <path d="M -45 25 C -70 -5 -50 -45 -30 -65 C -25 -50 -25 -30 -20 -15 C -20 5 -30 20 -45 25 Z" fill="#c91026"/>

    <!-- Labels around logo -->
    <text x="0" y="85" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-weight="bold" font-size="21" fill="#1e293b" text-anchor="middle" letter-spacing="1">Coral Maanaim</text>
    <text x="0" y="-85" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-weight="600" font-size="16" fill="#475569" text-anchor="middle" letter-spacing="1.5">Igreja Metodista Unida</text>
  </g>

  <!-- 3D Realistic Megaphone (Top Left, Angled Down-Right) -->
  <g id="megaphone" transform="translate(420, 320) rotate(32)" filter="url(#megaShadow)">
    <!-- Flared Bell Ring (Front opening) -->
    <ellipse cx="0" cy="0" rx="45" ry="190" fill="#c91026"/>
    <ellipse cx="5" cy="0" rx="35" ry="175" fill="#ffffff"/>
    <ellipse cx="20" cy="0" rx="20" ry="130" fill="#2d3748"/>
    <!-- Central driver bullet in megaphone -->
    <ellipse cx="25" cy="0" rx="14" ry="40" fill="#ffffff"/>

    <!-- Red Cone body -->
    <path d="M 0 -190 L -280 -65 L -280 65 L 0 190 Z" fill="url(#coneGrad)"/>
    
    <!-- White Rear Housing -->
    <rect x="-370" y="-65" width="90" height="130" rx="10" fill="#f8fafc"/>
    <path d="M -370 -65 L -420 -40 L -420 40 L -370 65 Z" fill="#e2e8f0"/>
    
    <!-- White Ergonomic Handle with Red Trigger -->
    <g transform="translate(-320, 65)">
      <!-- Handle -->
      <path d="M 0 0 L -25 180 C -28 205 0 220 25 210 L 40 200 C 60 190 60 170 50 150 L 35 0 Z" fill="#f8fafc" stroke="#cbd5e1" stroke-width="2"/>
      <path d="M 8 30 L -10 160 L 5 160 L 22 30 Z" fill="#e2e8f0"/>
      <!-- Trigger in red -->
      <rect x="25" y="40" width="22" height="45" rx="5" fill="#e71d36"/>
    </g>

    <!-- Chrome Rim Highlight -->
    <path d="M 0 -190 C 20 -150 25 -50 25 0 C 25 50 20 150 0 190 L -10 188 C 10 150 15 50 15 0 C 15 -50 10 -150 -10 -188 Z" fill="#ffffff" opacity="0.4"/>
  </g>

  <!-- Main Crimson Content Section -->
  <g transform="translate(220, 680)">
    <!-- "Comunicado Importante" -->
    <text x="0" y="0" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-weight="900" font-size="82" fill="#ffffff" letter-spacing="-1">
      Comunicado
    </text>
    <text x="0" y="85" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-weight="900" font-size="94" fill="#ffffff" letter-spacing="-1">
      Importante
    </text>

    <!-- "Na sexta teremos ensaio" -->
    <g transform="translate(0, 240)">
      <text x="0" y="0" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-weight="900" font-size="64" fill="#ffffff">
        Na sexta teremos
      </text>
      <text x="0" y="70" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-weight="900" font-size="72" fill="#ffffff">
        ensaio
      </text>
    </g>

    <!-- Schedule: "No busto as 15:00 horas" -->
    <g transform="translate(0, 480)">
      <text x="0" y="0" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-weight="300" font-size="60" fill="#ffd1d6" letter-spacing="1">
        No busto as 15:00
      </text>
      <text x="0" y="70" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-weight="300" font-size="60" fill="#ffd1d6" letter-spacing="1">
        horas
      </text>
    </g>

    <!-- Biblical verse: 2 Samuel 22:50 -->
    <g transform="translate(0, 720)">
      <text x="0" y="0" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-weight="700" font-size="44" fill="#ffffff">
        "Por isso te louvarei entre as
      </text>
      <text x="0" y="55" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-weight="700" font-size="44" fill="#ffffff">
        nações,ó Senhor cantarei
      </text>
      <text x="0" y="110" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-weight="700" font-size="44" fill="#ffffff">
        louvores ao teu nome."
      </text>
      
      <!-- Citation -->
      <text x="0" y="210" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-weight="900" font-size="48" fill="#ffffff">
        2 Samuel 22:50
      </text>
    </g>
  </g>

  <!-- Bottom Left: Checkmark Accent Symbol -->
  <g transform="translate(140, 1660)">
    <path d="M -160 50 L -80 130 L 70 -20 L 40 -50 L -80 70 L -130 20 Z" fill="#000000"/>
  </g>
</svg>
